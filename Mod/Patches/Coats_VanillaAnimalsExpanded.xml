<!--
	Vanilla Animals Expanded - VanillaExpanded.VanillaAnimalsExpanded - carries the twenty-one
	cat and dog breeds that used to be the separate Cats and Dogs module, and gives none of them
	a coat variation of its own.

	Fourteen of those twenty-one already have hand-painted coats, from purpleyam's own
	Colorful Coats - Vanilla Animals Expanded! - ported as Colorful Coats - Vanilla Animals
	Expanded! Renew, nelim.colorfulcoats.vaerenew. Painted coats beat tinted ones every time,
	so this file deliberately covers only the seven breeds purpleyam never drew:

		AEXP_CatAbyssinian  AEXP_Beagle  AEXP_Corgi  AEXP_FrenchBulldog
		AEXP_GermanShepherd  AEXP_Pug  AEXP_WelshTerrier

	Keeping the two mods on disjoint breeds is not only politeness: both add an
	<alternateGraphics> element, and two of them on one def would leave the loader to pick one.

	These seven are the closest the palette comes home: it was measured from coats purpleyam
	painted over these very sprites, in this very mod, for their fourteen neighbours. The
	header of Coats_StrayDogs.xml has the table and the provenance of each value.

		ink       (102, 94, 90)   blue      (111,124,166)   grey      (122,122,122)
		stone     (137,132,130)   chocolate (138,113, 98)   coffee    (145,120,100)
		slate     (150,155,171)   ashblue   (155,174,176)   iceblue   (188,228,255)
		silver    (192,192,192)   mist      (195,206,208)   taupe     (221,197,170)
		oatmeal   (231,216,204)   fawn      (234,216,172)   champagne (242,205,190)
		apricot   (246,244,215)   ivory     (255,249,201)
-->

<Patch>

	<!-- Abyssinian - blue, fawn and sorrel are the three the breed is bred for, beside the
	     ruddy one the mod already ships. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "AEXP_CatAbyssinian"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "AEXP_CatAbyssinian"]</xpath>
			<value>
				<alternateGraphicChance>0.6</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(150,155,171)</color></li>
					<li><color>(231,216,204)</color></li>
					<li><color>(242,205,190)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- Beagle - tricolour, lemon and the dark one. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "AEXP_Beagle"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "AEXP_Beagle"]</xpath>
			<value>
				<alternateGraphicChance>0.6</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(231,216,204)</color></li>
					<li><color>(242,205,190)</color></li>
					<li><color>(137,132,130)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- Corgi - red, sable and the blue-grey merle. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "AEXP_Corgi"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "AEXP_Corgi"]</xpath>
			<value>
				<alternateGraphicChance>0.6</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(221,197,170)</color></li>
					<li><color>(242,205,190)</color></li>
					<li><color>(150,155,171)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- French bulldog - cream, fawn and chocolate. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "AEXP_FrenchBulldog"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "AEXP_FrenchBulldog"]</xpath>
			<value>
				<alternateGraphicChance>0.6</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(231,216,204)</color></li>
					<li><color>(221,197,170)</color></li>
					<li><color>(138,113,98)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- German shepherd - the grey sable, the pale one, and the slate. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "AEXP_GermanShepherd"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "AEXP_GermanShepherd"]</xpath>
			<value>
				<alternateGraphicChance>0.5</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(195,206,208)</color></li>
					<li><color>(231,216,204)</color></li>
					<li><color>(150,155,171)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- Pug - fawn and black, as in the other pack. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "AEXP_Pug"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "AEXP_Pug"]</xpath>
			<value>
				<alternateGraphicChance>0.5</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(234,216,172)</color></li>
					<li><color>(102,94,90)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- Welsh terrier. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "AEXP_WelshTerrier"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "AEXP_WelshTerrier"]</xpath>
			<value>
				<alternateGraphicChance>0.5</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(195,206,208)</color></li>
					<li><color>(231,216,204)</color></li>
					<li><color>(242,205,190)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

</Patch>
