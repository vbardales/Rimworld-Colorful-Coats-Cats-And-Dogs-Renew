		</nomatch>
	</Operation>

	<!-- Japanese bobtail. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "akaNEKO_J_Bobtail"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "akaNEKO_J_Bobtail"]</xpath>
			<value>
				<alternateGraphicChance>0.6</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(138,113,98)</color></li>
					<li><color>(122,122,122)</color></li>
					<li><color>(111,124,166)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- Maine coon - a dark texture, so no light tint can show: two dark tints (charcoal, blue) at a low chance, the visible spread there is. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "akaNEKO_Maine_Coon"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "akaNEKO_Maine_Coon"]</xpath>
			<value>
				<alternateGraphicChance>0.5</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(102,94,90)</color></li>
					<li><color>(111,124,166)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

t<!-- Russian blue - a blue cat stays a blue cat; the coats are a bluer one, a warm brown and a charcoal, all darker
	     than the sprite so they show (owner, 2026-10-12). -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "akaNEKO_Russian_Blue"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
