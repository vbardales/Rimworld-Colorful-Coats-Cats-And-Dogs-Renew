					<li><color>(138,113,98)</color></li>
					<li><color>(102,94,90)</color></li>
					<li><color>(122,122,122)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- Brown tabby - dark to begin with, so two dark tints (charcoal, ash blue) at a low chance. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "akaNEKO_kijitora"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "akaNEKO_kijitora"]</xpath>
			<value>
				<alternateGraphicChance>0.4</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(102,94,90)</color></li>
					<li><color>(155,174,176)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- akaNEKO_kuroneko, the black cat, is left alone on purpose. See the note at the top. -->

</Patch>
