<!--
	Let's Have a Cat! Continued, by akairo and Bernau31 - akairo.LetsHaveaCat - twelve cat
	breeds on 1.6, none of which has a single coat variation.

	Eleven of the twelve get coats here. The black cat does not, and that is deliberate: a
	tint multiplies the sprite, so it can only darken, and the black cat's texture already
	averages 29 out of 255. Every tint on it would land within a couple of shades of the
	original. A feature nobody can see is worse than no feature.

	The rest are sorted by how much room their texture leaves, measured from the sprites
	themselves. The white cat is the best canvas in either mod and gets five coats; the dark
	ones get two dark tints and a low chance (a light tint cannot show on them).

	The palette is purpleyam's, measured from the 78 coat files of Colorful Coats - Cats and Dogs!
	and divided by the sprites they were painted over. The header of Coats_StrayDogs.xml has
	the whole table and the provenance of each value; scripts/Measure-Coats.ps1 recomputes it.

		ink       (102, 94, 90)   blue      (111,124,166)   grey      (122,122,122)
		stone     (137,132,130)   chocolate (138,113, 98)   coffee    (145,120,100)
		slate     (150,155,171)   ashblue   (155,174,176)   iceblue   (188,228,255)
		silver    (192,192,192)   mist      (195,206,208)   taupe     (221,197,170)
		oatmeal   (231,216,204)   fawn      (234,216,172)   champagne (242,205,190)
		apricot   (246,244,215)   ivory     (255,249,201)

	Four of purpleyam's cats have a namesake here - persian, maine coon, siamese, norwegian
	forest. Their textures are not reused: they are painted over Vanilla Animals Expanded's
	cats, at twice these sprites' resolution, and would swap one mod's art for another's on
	half the animals of a breed. The colours travel; the pixels do not.
-->

<Patch>

	<!-- Every Let's Have a Cat! cat that gets coats is drawn with the CutoutComplex shader and ships no mask texture,
	     so a tint on it barely shows: twelve white cats side by side stayed white (Pickle 08-revue, 2026-10-10).
	     The plain Cutout shader multiplies the sprite by the tint, which is what these coats need. Same
	     <success>Always</success> as the coats: without the mod the xpath matches nothing and costs nothing.
	     The black cat is excluded, it gets no coats. -->
	<Operation Class="PatchOperationReplace">
		<success>Always</success>
		<xpath>/Defs/PawnKindDef[starts-with(defName, "akaNEKO_") and defName != "akaNEKO_kuroneko"]/lifeStages/li/bodyGraphicData/shaderType</xpath>
		<value>
			<shaderType>Cutout</shaderType>
		</value>
	</Operation>

	<!-- White cat - the one texture light enough to take any colour. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "akaNEKO_shironeko"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "akaNEKO_shironeko"]</xpath>
			<value>
				<alternateGraphicChance>0.8</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(242,205,190)</color></li>
					<li><color>(111,124,166)</color></li>
					<li><color>(122,122,122)</color></li>
					<li><color>(234,216,172)</color></li>
					<li><color>(102,94,90)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- Persian - the other light one, and it takes purpleyam's own persian tint. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "akaNEKO_Persian"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "akaNEKO_Persian"]</xpath>
			<value>
				<alternateGraphicChance>0.7</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(221,197,170)</color></li>
					<li><color>(234,216,172)</color></li>
					<li><color>(195,206,208)</color></li>
					<li><color>(138,113,98)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- Siamese - blue point, chocolate point, a warmer seal. Dark tints: the pale ones did not show (owner, 2026-10-12). -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "akaNEKO_Siamese"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "akaNEKO_Siamese"]</xpath>
			<value>
				<alternateGraphicChance>0.7</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(111,124,166)</color></li>
					<li><color>(138,113,98)</color></li>
					<li><color>(145,120,100)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- Scottish fold, long-haired. -->
	<Operation Class="PatchOperationConditional">
