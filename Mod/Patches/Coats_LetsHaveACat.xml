			<xpath>/Defs/PawnKindDef[defName = "akaNEKO_Scottish_Fold_Long"]</xpath>
			<value>
				<alternateGraphicChance>0.6</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(138,113,98)</color></li>
					<li><color>(122,122,122)</color></li>
					<li><color>(111,124,166)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- Scottish fold. -->
