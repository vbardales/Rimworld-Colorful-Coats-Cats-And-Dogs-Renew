		</nomatch>
	</Operation>

	<!-- American shorthair. Silver and light, so the two coats are darker tints (brown, charcoal): the first pair, two near-white tints, did not show on it (owner, 2026-10-12). -->
	<Operation Class="PatchOperationConditional">
