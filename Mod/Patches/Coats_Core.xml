<?xml version="1.0" encoding="utf-8" ?>

<!--
	The four pets RimWorld ships with. In 1.6 Core, none of Husky, LabradorRetriever,
	YorkshireTerrier and Cat has a single alternateGraphics entry - the guinea pig and the horse
	do, and the pets do not.

	Two living mods already cover three of the four with hand-painted textures: Animal Variety
	Coats (cucumpear.azrael.varietycoats) does the cat, the husky and the labrador, and Erin's
	Cat Overhaul (Erin.Cats) gives the cat nineteen coats of its own. Painted beats tinted, so
	each operation below fires only when the animal still has nothing, and About.xml asks to
	load after both. The yorkshire terrier is the one nobody has ever covered.

	The palette is purpleyam's, measured from the coats of Colorful Coats - Cats and Dogs!;
	the header of Coats_StrayDogs.xml has the table and the provenance of each value.

		ink       (102, 94, 90)   blue      (111,124,166)   grey      (122,122,122)
		stone     (137,132,130)   chocolate (138,113, 98)   coffee    (145,120,100)
		slate     (150,155,171)   ashblue   (155,174,176)   iceblue   (188,228,255)
		silver    (192,192,192)   mist      (195,206,208)   taupe     (221,197,170)
		oatmeal   (231,216,204)   fawn      (234,216,172)   champagne (242,205,190)
		apricot   (246,244,215)   ivory     (255,249,201)
-->

<Patch>

	<!-- Labrador retriever - chocolate, yellow and black, which is the whole breed. The
	     chocolate and the black are purpleyam's poodle coats; they were the same two colours. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "LabradorRetriever"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "LabradorRetriever"]</xpath>
			<value>
				<alternateGraphicChance>0.7</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(138,113,98)</color></li>
					<li><color>(234,216,172)</color></li>
					<li><color>(102,94,90)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- Husky - grey, red and the pale one. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "Husky"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "Husky"]</xpath>
			<value>
				<alternateGraphicChance>0.6</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(188,228,255)</color></li>
					<li><color>(145,120,100)</color></li>
					<li><color>(231,216,204)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- Yorkshire terrier - steel blue and tan, and the two paler ones. Nothing else patches
	     this animal in 1.6, in or out of the game. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "YorkshireTerrier"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "YorkshireTerrier"]</xpath>
			<value>
				<alternateGraphicChance>0.6</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(150,155,171)</color></li>
					<li><color>(221,197,170)</color></li>
					<li><color>(231,216,204)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

	<!-- Cat - the fallback for a colony running neither Erin's Cat Overhaul nor Animal Variety
	     Coats. Either of those wins the moment it is active. The grey is purpleyam's munchkin. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/PawnKindDef[defName = "Cat"]/alternateGraphics</xpath>
		<nomatch Class="PatchOperationAdd">
			<success>Always</success>
			<xpath>/Defs/PawnKindDef[defName = "Cat"]</xpath>
			<value>
				<alternateGraphicChance>0.7</alternateGraphicChance>
				<alternateGraphics>
					<li><color>(122,122,122)</color></li>
					<li><color>(111,124,166)</color></li>
					<li><color>(242,205,190)</color></li>
					<li><color>(231,216,204)</color></li>
				</alternateGraphics>
			</value>
		</nomatch>
	</Operation>

</Patch>
